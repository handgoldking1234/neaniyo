{
  "git": {
    "deploymentEnabled": {
      "daily-queue": false,
      "feed": false
    }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/share?sitemap=1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/p/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/guide",
      "destination": "/guide.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/results",
      "schedule": "0 1 * * *"
    }
  ]
}